<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
    <AccelerateBuildsInVisualStudio>True</AccelerateBuildsInVisualStudio>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>26.221.1</Version>
    <Authors>Shun</Authors>
    <UseWPF>true</UseWPF>
    <AuthorsName>Shun</AuthorsName>
    <CompanyName>Snet</CompanyName>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <PackageProjectUrl>https://snet.cn</PackageProjectUrl>
    <Product>Windows</Product>
    <Description>界面组件：Controls（控件、转换器、模型、枚举、处理、消息、多语言）</Description>
    <PackageIcon>icon.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\icon.png" Pack="true" PackagePath="\" />
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Snet.Windows.Core" Version="26.221.1" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="property\wpf\Controls\ColorPicker\ColorPicker.png" />
    <Resource Include="property\wpf\Controls\ColorPicker\Hsv.png" />
    <Resource Include="property\wpf\DataGrid\Cursors\AutoFill.cur" />
    <Resource Include="property\wpf\DataGrid\Cursors\Cross.cur" />
    <Resource Include="property\wpf\DataGrid\Cursors\DownArrow.cur" />
    <Resource Include="property\wpf\DataGrid\Cursors\RightArrow.cur" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="edit\Search\next.png" />
    <None Remove="edit\Search\prev.png" />
    <None Remove="edit\RightArrow.cur" />
    <Resource Include="edit\Search\next.png" />
    <Resource Include="edit\Search\prev.png" />
    <Resource Include="edit\RightArrow.cur" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="edit\Highlighting\Resources\*" />
    <EmbeddedResource Include="edit\Highlighting\Resources\*" />
    <EmbeddedResource Remove="edit\Highlighting\Resources\Resources.cs" />
    <Resource Include="edit\Highlighting\Resources\Resources.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Language.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Language.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Language.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Language.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
</Project>