<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:editing="clr-namespace:Snet.Windows.Controls.edit.Editing">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Snet.Windows.Controls;component/edit/TextEditor.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Snet.Windows.Controls;component/edit/Search/DropDownButton.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Snet.Windows.Controls;component/edit/Search/SearchPanel.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Snet.Windows.Controls;component/edit/CodeCompletion/CompletionList.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Snet.Windows.Controls;component/edit/CodeCompletion/InsightWindow.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type editing:LineNumberMargin}">
        <Setter Property="Control.Cursor" Value="pack://application:,,,/Snet.Windows.Controls;component/edit/RightArrow.cur" />
    </Style>
</ResourceDictionary>
